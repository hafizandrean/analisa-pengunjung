# ==============================================================================
# Ayam Bang Jungko — CCTV Visitor Counting & Crowd Analytics
# Environment Variables Configuration Template
# ==============================================================================

# Application & Environment
APP_ENV=development
PROJECT_NAME="Ayam Bang Jungko - Visitor Counting & Crowd Analytics"
TIMEZONE=Asia/Jakarta

# Security & Authentication (Generate random 32+ char secret in production)
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ayam_bang_jungko_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ayam_bang_jungko_db

# Computer Vision Configuration
YOLO_MODEL_NAME=yolov8n.pt
TRACKER_TYPE=bytetrack
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
VIDEO_INPUT_SOURCE=samples/video_sample.mp4

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
