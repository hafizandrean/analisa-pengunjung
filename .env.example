# ==============================================================================
# Ayam Bang Jungko — CCTV Visitor Counting & Crowd Analytics
# Lingkungan PHP Native + Python AI Vision
# ==============================================================================

# Aplikasi & Zona Waktu
APP_ENV=development
PROJECT_NAME="Ayam Bang Jungko - Visitor Counting & Crowd Analytics"
TIMEZONE=Asia/Jakarta

# Konfigurasi Database PHP (Default: sqlite, atau ubah ke mysql untuk XAMPP)
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=analisa_pengunjung
DB_USER=root
DB_PASS=

# AI Computer Vision (YOLOv8 + ByteTrack)
YOLO_MODEL_NAME=vision/models/yolov8n.pt
TRACKER_TYPE=bytetrack
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
VIDEO_INPUT_SOURCE=samples/video_sample.mp4

# Endpoint Target Dispatcher Python ke PHP Native
PHP_API_URL=http://127.0.0.1:8000/api/events.php
